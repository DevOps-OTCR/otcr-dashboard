# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to ../.env.production and fill in your production values
# NEVER commit .env.production to git!
# ============================================================================

# ============================================================================
# FRONTEND ENVIRONMENT (Next.js)
# ============================================================================
# Authentication
NEXT_PUBLIC_MSAL_CLIENT_ID=...
NEXT_PUBLIC_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GEOAPIFY_API_KEY=
NEXTAUTH_URL=http://localhost:3000

#Google Calendar
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=


# ============================================================================
# BACKEND ENVIRONMENT (NestJS)
# ============================================================================

# DATABASE
# DATABASE_URL can use a pooled/transaction endpoint for normal app traffic.
DATABASE_URL=postgresql://user:password@pooler-host:6543/otcr_dashboard?schema=public
# DIRECT_URL should use the direct Postgres host for Prisma schema commands like db push/migrate.
DIRECT_URL=postgresql://user:password@direct-host:5432/otcr_dashboard?schema=public

# REDIS (Production instance)
REDIS_HOST=your-production-redis-host
REDIS_PORT=6379
REDIS_URL=redis://your-production-redis-host:6379
# If using Redis Cloud or managed service:
# REDIS_URL=rediss://default:password@your-redis-host:port

# GOOGLE CALENDAR
GOOGLE_CALENDAR_CLIENT_EMAIL=""
GOOGLE_CALENDAR_PRIVATE_KEY=""
GOOGLE_CALENDAR_FIRMWIDE_ID=""
GOOGLE_CALENDAR_TIMEZONE="America/Chicago"

# NOTIFICATIONS
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/integrations/slack/oauth/callback"
SLACK_SCOPES="chat:write,im:write,users:read,users:read.email"
SLACK_BOT_TOKEN_ENCRYPTION_KEY=""


# APPLICATION
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://yourdomain.com

# CMS issue intake. Enable only after deploying the feedback GitHub migration
# and the form disclosure. New dashboard reports only; no historical backfill.
CMS_GITHUB_ENABLED=false
CMS_GITHUB_REPOSITORY=DevOps-OTCR/otcr-dashboard
# Server-only token with metadata read and issues read/write for this repository.
CMS_GITHUB_TOKEN=
# Optional automatic Copilot routing for narrowly scoped text/style/docs issues.
CMS_COPILOT_ENABLED=false
# User token for an account with paid Copilot and repository access.
# Fine-grained token: actions, contents, issues, pull requests read/write; metadata read.
CMS_COPILOT_TOKEN=
CMS_COPILOT_BASE_BRANCH=main
