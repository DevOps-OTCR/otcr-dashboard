# Agentic CMS / OTCR Bot backend settings (placeholders only — never commit real values).
# Copy these lines into backend/.env. For the rest of the CMS settings
# (database, Azure AD, etc.) see ../env/env.example.
# These are read only by the backend. Never add them to the frontend or a NEXT_PUBLIC_ variable.

# Release flag. Only the exact value "true" enables it; keep "false" unless you are testing.
AGENTIC_CMS_ENABLED=false
# Comma-separated pilot emails. Empty = every signed-in CMS user when enabled.
# For local testing, set this to your own CMS sign-in email.
AGENTIC_CMS_ALLOWED_EMAILS=

# Lumen OpenAI-compatible API (https://lumen.ncsa.illinois.edu/help/api)
LUMEN_BASE_URL=https://lumen.ncsa.illinois.edu/v1

# check that this is a vision model for Powerpoint review 
# (deepseek-v4.1-flash-1017, gemma-4-31b-it, muse-glimmer-30b, qwen3.6-35b-a3b, qwen3.8-27b, qwen3.8-flash)
LUMEN_MODEL=deepseek-v4.1-flash 
# Local development: your own key from Lumen > Profile > API Keys.
# Shared deployment: entered by Isaiah in the Render environment settings.
# Blank = OTCR Bot replies with a "not set up" error.
LUMEN_API_KEY=

# Web search (https://tavily.com, free tier). Blank = no web_search tool.
TAVILY_API_KEY=

# Per-user message limit per hour (default 60).
OTCR_BOT_MAX_MESSAGES_PER_HOUR=60

# Optional: skills folder. Default: <repo>/agentic-cms/skills
AGENTIC_CMS_SKILLS_DIR=

# Microsoft Graph — PowerPoint review (fetch_pptx_content, add_pptx_comments).
# Two auth modes — use whichever your tenant supports:
#
# Mode A — delegated (recommended for most tenants, no M365 Business license needed):
#   1. Register an app, add delegated permissions Files.ReadWrite + offline_access
#   2. Add a Mobile/desktop redirect URI: https://login.microsoftonline.com/common/oauth2/nativeclient
#   3. Run: node scripts/msgraph-signin.cjs  (prints a MSGRAPH_REFRESH_TOKEN to paste here)
#   Set MSGRAPH_CLIENT_ID, MSGRAPH_TENANT_ID, MSGRAPH_REFRESH_TOKEN. Leave CLIENT_SECRET blank.
#
# Mode B — application/client credentials (requires Files.ReadWrite.All + admin consent):
#   Set MSGRAPH_CLIENT_ID, MSGRAPH_TENANT_ID, MSGRAPH_CLIENT_SECRET. Leave REFRESH_TOKEN blank.
#
# Leave all blank to disable the pptx tools.
MSGRAPH_CLIENT_ID=
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_REFRESH_TOKEN=
# Set to true only when using a vision-capable model endpoint (enables get_pptx_slide_images).
MSGRAPH_VISION_ENABLED=false
