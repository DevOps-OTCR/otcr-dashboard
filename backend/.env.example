# Agentic CMS / OTCR Bot backend settings (placeholders only — never commit real values).
# Copy these lines into backend/.env. For the rest of the CMS settings
# (database, Azure AD, etc.) see ../env/env.example.
# These are read only by the backend. Never add them to the frontend or a NEXT_PUBLIC_ variable.

# Release flag. Only the exact value "true" enables it; keep "false" unless you are testing.
AGENTIC_CMS_ENABLED=false
# Comma-separated pilot emails. Empty = every signed-in CMS user when enabled.
# For local testing, set this to your own CMS sign-in email.
AGENTIC_CMS_ALLOWED_EMAILS=

# Lumen OpenAI-compatible API (https://lumen.ncsa.illinois.edu/help/api)
LUMEN_BASE_URL=https://lumen.ncsa.illinois.edu/v1
LUMEN_MODEL=deepseek-v4.1-flash
# Local development: your own key from Lumen > Profile > API Keys.
# Shared deployment: entered by Isaiah in the Render environment settings.
# Blank = OTCR Bot replies with a "not set up" error.
LUMEN_API_KEY=

# Web search (https://tavily.com, free tier). Blank = no web_search tool.
TAVILY_API_KEY=

# Per-user message limit per hour (default 60).
OTCR_BOT_MAX_MESSAGES_PER_HOUR=60

# Optional: skills folder. Default: <repo>/agentic-cms/skills
AGENTIC_CMS_SKILLS_DIR=
